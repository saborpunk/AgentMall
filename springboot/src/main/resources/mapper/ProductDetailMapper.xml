<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.ProductDetailMapper">



    <insert id="insert" parameterType="com.example.entity.ProductDetail" useGeneratedKeys="true">
        insert into product_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="productId != null">product_id,</if>
            <if test="detailContent != null">detail_content,</if>
            <if test="packageInfo != null">package_info,</if>
            <if test="afterSaleInfo != null">after_sale_info,</if>
            <if test="aiSummary != null">ai_summary,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="productId != null">#{productId},</if>
            <if test="detailContent != null">#{detailContent},</if>
            <if test="packageInfo != null">#{packageInfo},</if>
            <if test="afterSaleInfo != null">#{afterSaleInfo},</if>
            <if test="aiSummary != null">#{aiSummary},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.ProductDetail">
        update product_detail
        <set>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="detailContent != null">detail_content = #{detailContent},</if>
            <if test="packageInfo != null">package_info = #{packageInfo},</if>
            <if test="afterSaleInfo != null">after_sale_info = #{afterSaleInfo},</if>
            <if test="aiSummary != null">ai_summary = #{aiSummary},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where id = #{id}
    </update>

</mapper>
